# Credentials for the Pareto Inference router (OpenAI-compatible).
# Copy to .env and fill in. .env is gitignored — never commit real keys.
PARETO_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
PARETO_BASE_URL=https://api.paretoinference.com/v1

# Key that Claude Code (and anything else local) uses to talk to the bridge.
# Any string you like; it never leaves your machine.
LITELLM_MASTER_KEY=sk-local-dev
