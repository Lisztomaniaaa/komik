rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Comments & reviews. Posting requires a real signed-in account (see
    // README's Firebase Auth setup step) — reading does not, so comments
    // are visible to everyone.
    match /comments/{commentId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 2000
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.manga_id is string
                    && request.resource.data.thread_id is string
                    && (request.resource.data.chapter_id == null || request.resource.data.chapter_id is string);

      // Nobody can edit or delete a comment, including their own, for now.
      // A future update could allow the original poster to (request.auth.uid
      // == resource.data.uid) once that's actually wired up client-side.
      allow update, delete: if false;
    }
  }
}
